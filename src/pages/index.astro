---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroHome from '../components/HeroHome.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemHome from '../components/ProblemHome.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { testimonials } from '../data/testimonials';
import { projects } from '../data/projects';
---

<Layout
    title="Ellveren | Technology for Growing Businesses"
    description="Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses."
    openGraph={{
        basic: {
            title: "Ellveren | Technology for Growing Businesses",
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
            description: "Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses.",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
        description: "Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses.",
    }}
>
    <Header />
    <main>
        <HeroHome />
        <TrustStrip
            items={[
                {
                    title: "Websites",
                    description: "Design and development, from landing pages to business websites."
                },
                {
                    title: "Software",
                    description: "Bespoke web applications, portals and integrations."
                },
                {
                    title: "Support",
                    description: "Hosting, maintenance and ongoing technical help."
                },
                {
                    title: "Growth",
                    description: "SEO and paid advertising to help customers find you."
                }
            ]}
        />
        <ProblemHome />
        <Process />
        <Portfolio projects={projects.slice(0, 6)} />
        <section class="section section-soft">
            <div class="container">
                <div class="cta-banner">
                    <h2>Ready to get started?</h2>
                    <p>A new website, a system that saves time, or dependable support for what you already have. We start with what your business needs.</p>
                    <a href="/services" class="btn btn-accent cta-banner-btn">Explore our services</a>
                </div>
            </div>
        </section>

        <Testimonials
            layout="featured"
            testimonials={[
                testimonials[10],
                testimonials[0],
                testimonials[1],
                testimonials[2],
            ]}
        />
        <FAQ />
        <CTA />
    </main>
    <Footer />
</Layout>

<style>
    .cta-banner {
        text-align: center;
        max-width: 600px;
        margin-inline: auto;
    }

    .cta-banner h2 {
        margin-inline: auto;
    }

    .cta-banner p {
        margin-top: 16px;
        font-size: 1.04rem;
    }

    .cta-banner-btn {
        margin-top: 32px;
    }
</style>
