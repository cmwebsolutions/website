---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroHome from '../components/HeroHome.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemHome from '../components/ProblemHome.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { testimonials } from '../data/testimonials';
import { projects } from '../data/projects';
import { gbp, carePlan, websiteBuilds } from '../data/plans';
import CircleCheckBig from '@lucide/astro/icons/circle-check-big';
---

<Layout
    title="Ellveren | Technology for Growing Businesses"
    description="Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses."
    openGraph={{
        basic: {
            title: "Ellveren | Technology for Growing Businesses",
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
            description: "Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses.",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
        description: "Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses.",
    }}
>
    <Header />
    <main>
        <HeroHome />
        <section class="section routes">
            <div class="container">
                <div class="routes-grid">
                    <article class="card">
                        <h3>Already have a website?</h3>
                        <p>Keep it secure, updated and backed up with a Care plan, from {gbp(carePlan.price)}/month. Start with a free health check.</p>
                        <a href="/plans" class="route-link">Care plans</a>
                    </article>
                    <article class="card">
                        <h3>Need a new website?</h3>
                        <p>Fixed-price websites, designed and built for your business, from {gbp(websiteBuilds.businessFrom)}.</p>
                        <a href="/websites" class="route-link">Websites</a>
                    </article>
                    <article class="card">
                        <h3>Need more than a website?</h3>
                        <p>Sites connected to your other systems, client portals and web apps.</p>
                        <a href="/websites#integrated" class="route-link">Integrated websites</a>
                    </article>
                </div>
            </div>
        </section>
        <TrustStrip
            items={[
                {
                    title: "Websites",
                    description: "Design and development, from landing pages to business websites."
                },
                {
                    title: "Software",
                    description: "Bespoke web applications, portals and integrations."
                },
                {
                    title: "Support",
                    description: "Hosting, maintenance and ongoing technical help."
                },
                {
                    title: "Growth",
                    description: "SEO and paid advertising to help customers find you."
                }
            ]}
        />
        <ProblemHome />
        <Process />
        <section class="section" id="why-ellveren">
            <div class="container">
                <div class="section-head">
                    <h2>Why Ellveren</h2>
                </div>
                <ul class="check-list why-list">
                    <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>One point of contact.</strong> You speak to the person responsible for your site, not an account manager.</span></li>
                    <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Clear plans, honest prices.</strong> Stated inclusions, stated hours and fixed-price projects. No overselling.</span></li>
                    <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Looked after properly.</strong> Weekly updates, same-day security patches, and daily off-site backups with a separate provider.</span></li>
                    <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Built to last.</strong> Some clients have been with me for over 10 years.</span></li>
                    <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Yours to keep.</strong> No long lock-ins, and your site and content always belong to you.</span></li>
                </ul>
                <p class="why-clients">Clients include accountancy, insurance, recruitment and hospitality businesses.</p>
            </div>
        </section>
        <Portfolio projects={projects.slice(0, 6)} />
        <section class="section section-soft">
            <div class="container">
                <div class="cta-banner">
                    <h2>Ready to get started?</h2>
                    <p>A new website, a system that saves time, or dependable support for what you already have. We start with what your business needs.</p>
                    <a href="/services" class="btn btn-accent cta-banner-btn">Explore our services</a>
                </div>
            </div>
        </section>

        <Testimonials
            layout="featured"
            testimonials={[
                testimonials[10],
                testimonials[0],
                testimonials[1],
                testimonials[2],
            ]}
        />
        <FAQ />
        <CTA />
    </main>
    <Footer />
</Layout>

<style>
    .routes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .routes-grid .card {
        display: flex;
        flex-direction: column;
    }

    .routes-grid .card p {
        flex: 1;
    }

    .route-link {
        margin-top: 20px;
        color: var(--primary);
        font-weight: 800;
        text-decoration: underline;
    }

    .why-list {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 36px;
        margin-top: 0;
    }

    .why-list strong {
        color: var(--black);
    }

    .why-clients {
        margin-top: 28px;
        font-size: 1.04rem;
    }

    @media (max-width: 980px) {
        .routes-grid,
        .why-list {
            grid-template-columns: 1fr;
        }
    }

    .cta-banner {
        text-align: center;
        max-width: 600px;
        margin-inline: auto;
    }

    .cta-banner h2 {
        margin-inline: auto;
    }

    .cta-banner p {
        margin-top: 16px;
        font-size: 1.04rem;
    }

    .cta-banner-btn {
        margin-top: 32px;
    }
</style>
