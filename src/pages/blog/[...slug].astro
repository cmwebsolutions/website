---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/post.css';

export async function getStaticPaths() {
    return Object.entries(import.meta.glob('/src/content/blog/*.mdx', {eager: true}))
        .map(([path, module]: [string, any]) => {
            const slug = path.split('/').pop()?.replace('.mdx', '') || '';
            return {
                params: {slug},
                props: {frontmatter: module.frontmatter, Content: module.Content},
            };
        });
}

const { frontmatter, Content } = Astro.props;

const formattedDate = new Date(frontmatter.date).toISOString();

function slugify(str: string): string {
    return str.toLowerCase().replace(/\s+/g, '-');
}
---

<Layout
    title={`${frontmatter.title} | Ellveren`}
    description={frontmatter.description}
    openGraph={{
        basic: {
            title: `${frontmatter.title} | Ellveren`,
            type: "article",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
        },
        article: {
            publishedTime: formattedDate,
            tags: frontmatter.tags ?? [frontmatter.category],
            authors: ["https://ellveren.com/about"],
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
        title: `${frontmatter.title} | Ellveren`,
        description: frontmatter.description,
    }}
>
    <Header />
    <main>
        <article class="section post-hero">
            <div class="post-bg"></div>
            <div class="container">
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: frontmatter.title }]} />
                <div class="post-header">
                    {frontmatter.category && (
                        <div class="post-categories">
                            <a class="post-category" href={`/blog/category/${slugify(frontmatter.category)}`}>{frontmatter.category}</a>
                        </div>
                    )}
                    <time class="post-date">{new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                    <h1>{frontmatter.title}</h1>
                    <p class="lead">{frontmatter.description}</p>
                </div>
            </div>
        </article>

        <div class="section post-content-wrap">
            <div class="container">
                <div class="post-content">
                    <Content />
                </div>
            </div>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .post-hero {
        position: relative;
        padding: 144px 0 80px;
        color: var(--white);
        overflow: hidden;
    }

    .post-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(65, 0, 245, 0.3) 0%, transparent 100%),
                    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(15, 210, 187, 0.12) 0%, transparent 100%),
                    var(--black);
        z-index: 0;
    }

    .post-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(252, 252, 252, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(252, 252, 252, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    .post-header {
        position: relative;
        z-index: 1;
        max-width: 720px;
    }

    .post-header h1 {
        color: var(--white);
    }

    .post-header :global(.lead) {
        color: var(--dark-muted);
    }

    .post-categories {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 16px;
    }

    .post-category {
        font-size: 0.76rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        color: var(--accent);
        background: rgba(15, 210, 187, 0.1);
        border: 1px solid rgba(15, 210, 187, 0.2);
        text-decoration: none;
        transition: background 180ms ease, color 180ms ease;
    }

    .post-category:hover {
        background: var(--accent);
        color: var(--black);
    }

    .post-date {
        display: block;
        font-size: 0.88rem;
        color: var(--dark-muted);
        margin-bottom: 16px;
    }

    .post-content-wrap {
        background: var(--surface-soft);
    }
</style>
