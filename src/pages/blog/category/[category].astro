---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTA from '../../../components/CTA.astro';
import Footer from '../../../components/Footer.astro';

interface PostMeta {
    slug: string;
    frontmatter: {
        title: string;
        description: string;
        date: Date;
        category: string;
    };
}

export async function getStaticPaths() {
    const posts: PostMeta[] = Object.entries(import.meta.glob('/src/content/blog/*.mdx', { eager: true }))
        .map(([path, module]: [string, any]) => ({
            slug: path.split('/').pop()?.replace('.mdx', '') || '',
            frontmatter: module.frontmatter,
        }));

    const categories = [...new Set(posts.map(p => p.frontmatter.category).filter(Boolean))];

    return categories.map(category => {
        const slug = category.toLowerCase().replace(/\s+/g, '-');
        return {
            params: { category: slug },
            props: { category, posts: posts.filter(p => p.frontmatter.category === category) },
        };
    });
}

const { category, posts } = Astro.props;

const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout
    title={`${category} Articles | Blog | Ellveren`}
    description={`Browse our articles about ${category.toLowerCase()} — tips, guides, and insights from Ellveren.`}
    openGraph={{
        basic: {
            title: `${category} Articles | Ellveren`,
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
    }}
>
    <Header />
    <main>
        <section class="section blog-hero">
            <div class="blog-bg"></div>
            <div class="container">
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: category }]} />
                <div class="blog-hero-content">
                    <span class="eyebrow">{category}</span>
                    <h1>{category} articles</h1>
                    <p class="lead">Browse our articles about {category.toLowerCase()}.</p>
                </div>
            </div>
        </section>

        <section class="section section-soft">
            <div class="container">
                <div class="blog-grid">
                    {sortedPosts.map((post) => (
                        <article class="blog-card">
                            <div class="blog-card-body">
                                <time class="blog-date">{new Date(post.frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                                <h2 class="blog-title">{post.frontmatter.title}</h2>
                                <p class="blog-desc">{post.frontmatter.description}</p>
                                <a class="blog-link" href={`/blog/${post.slug}`} aria-label={`Read more about ${post.frontmatter.title}`}>Read more →</a>
                            </div>
                        </article>
                    ))}
                </div>

                {sortedPosts.length === 0 && (
                    <p class="blog-empty">No posts in this category yet. Check back soon.</p>
                )}

                <div class="blog-back">
                    <a href="/blog/" class="blog-link">← Back to all articles</a>
                </div>
            </div>
        </section>

        <CTA />
    </main>
    <Footer />
</Layout>

<style>
    .blog-hero {
        position: relative;
        padding: 144px 0 100px;
        color: var(--white);
        overflow: hidden;
    }

    .blog-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(65, 0, 245, 0.3) 0%, transparent 100%),
                    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(15, 210, 187, 0.12) 0%, transparent 100%),
                    var(--black);
        z-index: 0;
    }

    .blog-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(252, 252, 252, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(252, 252, 252, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
    }

    .blog-hero .container {
        position: relative;
        z-index: 1;
    }

    .blog-hero-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        margin-inline: auto;
        text-align: center;
    }

    .blog-hero-content h1 {
        color: var(--white);
        margin-inline: auto;
    }

    .blog-hero-content :global(.lead) {
        color: var(--dark-muted);
        margin-inline: auto;
    }

    .blog-hero-content :global(.eyebrow) {
        color: var(--accent);
        background: rgba(15, 210, 187, 0.1);
        border-color: rgba(15, 210, 187, 0.2);
        margin-inline: auto;
    }

    .blog-hero-content :global(.eyebrow)::before {
        background: var(--accent);
        box-shadow: 0 0 0 5px rgba(15, 210, 187, 0.18);
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
    }

    .blog-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        transition: transform 240ms ease, box-shadow 240ms ease;
    }

    .blog-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-card);
    }

    .blog-card-body {
        padding: 24px;
    }

    .blog-date {
        display: block;
        font-size: 0.84rem;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .blog-title {
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 8px;
    }

    .blog-desc {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 16px;
    }

    .blog-link {
        font-weight: 700;
        color: var(--primary);
        font-size: 0.9rem;
        transition: gap 180ms ease;
    }

    .blog-link:hover {
        gap: 6px;
    }

    .blog-empty {
        text-align: center;
        padding: 60px 0;
        color: var(--muted);
    }

    .blog-back {
        text-align: center;
        margin-top: 48px;
    }

    @media (max-width: 980px) {
        .blog-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>