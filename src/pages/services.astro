---
import GradientText from '../components/GradientText.astro';
import HeroGrid from '../components/HeroGrid.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import PlanTable from '../components/PlanTable.astro';
import RouteCards from '../components/RouteCards.astro';
import WhyEllveren from '../components/WhyEllveren.astro';
import Testimonials from '../components/Testimonials.astro';
import { testimonials } from '../data/testimonials';
import Photo from '../components/Photo.astro';
import { photos } from '../data/images';
import {
    gbp,
    managedPlan,
    planComparisonColumns,
    planComparisonRows,
    websiteComparisonColumns,
    websiteComparisonRows,
} from '../data/plans';

const description = 'Ellveren designs, builds and looks after websites for established UK businesses, with clear monthly plans.';
---

<Layout
    title="Services | Ellveren"
    description={description}
    openGraph={{
        basic: {
            title: "Services | Ellveren",
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
    }}
>
    <Header />
    <main>
        <section class="section services-hero">
            <div class="services-bg"><HeroGrid /></div>
            <div class="container">
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
                <div class="services-hero-content">
                    <h1>What we <GradientText>offer</GradientText></h1>
                    <p class="lead">{description}</p>
                    <div class="hero-actions">
                        <a href="/plans" class="btn btn-accent">See the plans</a>
                        <a href="/contact?interest=new-website" class="btn btn-ghost">Talk about your project</a>
                    </div>
                </div>
            </div>
        </section>

        <RouteCards />

        <section class="section section-soft" id="care-plans">
            <div class="container">
                <div class="section-head">
                    <h2>Care plans</h2>
                </div>
                <div class="section-photo">
                    <Photo photo={photos.servicesCare} aspect="21 / 9" sizes="(max-width: 1200px) 100vw, 1160px" />
                </div>
                <PlanTable caption="Care plans" columns={planComparisonColumns} rows={planComparisonRows} />
                <p class="table-note">Same price whether we host your site or it runs on your own server.</p>
                <a href="/plans" class="btn btn-primary section-btn">See the plans</a>
            </div>
        </section>

        <section class="section" id="websites">
            <div class="container">
                <div class="section-head">
                    <h2>Websites</h2>
                </div>
                <div class="section-photo">
                    <Photo photo={photos.servicesWebsites} aspect="21 / 9" sizes="(max-width: 1200px) 100vw, 1160px" />
                </div>
                <PlanTable caption="Websites" columns={websiteComparisonColumns} rows={websiteComparisonRows} />
                <p class="table-note">Smaller business? The <a href="/managed-website-plan">Managed Website Plan</a> gets you a new 5-page website for {gbp(managedPlan.setup)} setup and {gbp(managedPlan.monthly)}/month.</p>
                <a href="/websites" class="btn btn-primary section-btn">Websites</a>
            </div>
        </section>

        <WhyEllveren />

        <Testimonials
            heading="Trusted by businesses we've built for."
            description="See what our clients say about working with us on their websites."
            layout="featured"
            testimonials={[
                testimonials[5],
                testimonials[3],
                testimonials[4],
                testimonials[9],
                testimonials[8],
                testimonials[11],
            ]}
        />

        <CTA />
    </main>
    <Footer />
</Layout>

<style>
    .services-hero {
        position: relative;
        padding: 144px 0 100px;
        color: var(--white);
        overflow: hidden;
    }

    .services-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(126, 168, 240, 0.3) 0%, transparent 100%),
                    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(245, 111, 81, 0.12) 0%, transparent 100%),
                    var(--black);
        z-index: 0;
    }

    .services-hero-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        margin-inline: auto;
        text-align: center;
    }

    .services-hero-content h1 {
        color: var(--white);
        margin-inline: auto;
    }

    .services-hero-content :global(.lead) {
        color: var(--dark-muted);
        margin-inline: auto;
    }

    .services-hero-content :global(.eyebrow) {
        color: var(--accent);
        background: rgba(245, 111, 81, 0.1);
        border-color: rgba(245, 111, 81, 0.2);
        margin-inline: auto;
    }

    .services-hero-content :global(.eyebrow)::before {
        background: var(--accent);
        box-shadow: 0 0 0 5px rgba(245, 111, 81, 0.18);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 32px;
    }

    .section-photo {
        margin-bottom: 28px;
    }

    @media (max-width: 640px) {
        .section-photo {
            --photo-aspect: 16 / 9;
        }
    }

    .table-note {
        margin-top: 20px;
        font-size: 0.94rem;
    }

    .table-note a {
        color: var(--primary);
        text-decoration: underline;
    }

    .section-btn {
        margin-top: 28px;
    }
</style>
