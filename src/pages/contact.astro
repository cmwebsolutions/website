---
import GradientText from '../components/GradientText.astro';
import HeroGrid from '../components/HeroGrid.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import { interests, budgets } from '../data/enquiry';
---

<Layout
    title="Contact | Ellveren | Get in Touch"
    description="Get in touch with Ellveren. Fill in our contact form or email hello@ellveren.com. We'll reply within 1 working day."
    openGraph={{
        basic: {
            title: "Contact | Ellveren | Get in Touch",
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
    }}
>
    <Header />
    <main>
        <section class="section contact-hero">
            <div class="contact-bg"><HeroGrid /></div>
            <div class="container">
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
                <div class="contact-hero-content">
                    <span class="eyebrow">Contact us</span>
                    <h1>Let's talk about <GradientText>your website</GradientText></h1>
                    <p class="lead">Tell us a little about what you need and we'll get back to you within 1 working day.</p>
                </div>
            </div>
        </section>

        <section class="section section-soft">
            <div class="container">
                <div class="contact-grid">
                    <div class="contact-form-wrap">
                        <div data-fs-success>
                            <strong>Thanks, <span id="success-name"></span>.</strong> We've got your message and will reply within 1 working day.
                        </div>
                        <div data-fs-error>
                            <strong>Oops!</strong> Something went wrong. Please try again or email us directly.
                        </div>
                        <form id="contact-form" class="contact-form" data-form-id="xdarkjga">
                            <div class="form-row">
                                <label class="form-label" for="name">Name</label>
                                <input class="form-input" type="text" id="name" name="name" required autocomplete="name" placeholder="e.g. Jane Smith" />
                                <span data-fs-error="name"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="email">Email</label>
                                <input class="form-input" type="email" id="email" name="email" required autocomplete="email" placeholder="jane@example.com" />
                                <span data-fs-error="email"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="phone">Phone</label>
                                <input class="form-input" type="tel" id="phone" name="phone" autocomplete="tel" placeholder="07700 900000" />
                                <span data-fs-error="phone"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="business">Business name</label>
                                <input class="form-input" type="text" id="business" name="business" autocomplete="organization" />
                                <span data-fs-error="business"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="website">Current website address</label>
                                <input class="form-input" type="text" inputmode="url" id="website" name="website" autocomplete="url" aria-describedby="website-help" />
                                <span class="form-help" id="website-help">If you have one</span>
                                <span data-fs-error="website"></span>
                            </div>
                            <fieldset class="form-row form-fieldset">
                                <legend class="form-label">What are you interested in?</legend>
                                <div class="radio-list">
                                    {interests.map((interest) => (
                                        <label class="checkbox-label">
                                            <input type="radio" name="interest" value={interest.label} data-slug={interest.slug} required />
                                            <span>{interest.label}</span>
                                        </label>
                                    ))}
                                </div>
                                <span data-fs-error="interest"></span>
                            </fieldset>
                            <div class="form-row">
                                <label class="form-label" for="budget">Budget</label>
                                <select class="form-input" id="budget" name="budget" aria-describedby="budget-help">
                                    <option value="">Select a budget</option>
                                    {budgets.map((budget) => <option>{budget}</option>)}
                                </select>
                                <span class="form-help" id="budget-help">A rough idea helps us recommend the right option</span>
                                <span data-fs-error="budget"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="message">Tell us about your project</label>
                                <textarea class="form-input form-textarea" id="message" name="message" rows="5" required placeholder="What do you need help with? Tell us about your goals and any existing websites or systems."></textarea>
                                <span data-fs-error="message"></span>
                            </div>
                            <div class="form-row">
                                <label class="form-label" for="source">How did you hear about Ellveren?</label>
                                <input class="form-input" type="text" id="source" name="source" />
                                <span data-fs-error="source"></span>
                            </div>
                            <button class="btn btn-accent form-submit" type="submit">Send enquiry</button>
                            <p class="form-privacy">We'll only use your details to reply to your enquiry. See the <a href="/privacy">privacy policy</a>.</p>
                        </form>
                    </div>

                    <aside class="contact-info">
                        <div class="contact-info-card">
                            <h3>Email</h3>
                            <a href="mailto:hello@ellveren.com">hello@ellveren.com</a>
                        </div>
                        <div class="contact-info-card">
                            <h3>Phone</h3>
                            <span>0330 229 6586</span>
                        </div>
                        <div class="contact-info-card">
                            <h3>LinkedIn</h3>
                            <a href="https://www.linkedin.com/company/ellveren/" target="_blank">Connect with us</a>
                        </div>
                        <div class="contact-info-card">
                            <h3>Response time</h3>
                            <span>Mon–Fri, 9am–5pm UK time</span>
                            <span class="contact-info-note">Usually within 1 business day</span>
                        </div>
                    </aside>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .contact-hero {
        position: relative;
        padding: 144px 0 100px;
        color: var(--white);
        overflow: hidden;
    }

    .contact-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(126, 168, 240, 0.3) 0%, transparent 100%),
                    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(245, 111, 81, 0.12) 0%, transparent 100%),
                    var(--black);
        z-index: 0;
    }

    .contact-hero-content {
        position: relative;
        z-index: 1;
        max-width: 620px;
    }

    .contact-hero-content h1 {
        color: var(--white);
    }

    .contact-hero-content :global(.lead) {
        color: var(--dark-muted);
    }

    .contact-hero-content :global(.eyebrow) {
        color: var(--accent);
        background: rgba(245, 111, 81, 0.1);
        border-color: rgba(245, 111, 81, 0.2);
    }

    .contact-hero-content :global(.eyebrow)::before {
        background: var(--accent);
        box-shadow: 0 0 0 5px rgba(245, 111, 81, 0.18);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        gap: 48px;
        align-items: start;
    }

    .contact-form-wrap {
        background: var(--surface);
        padding: 36px 32px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
    }

    .form-row {
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 700;
        font-size: 0.92rem;
    }

    .form-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--surface-soft);
        font-size: 0.96rem;
        color: var(--text);
        outline: none;
        transition: border-color 180ms ease, box-shadow 180ms ease;
    }

    .form-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(4, 79, 200, 0.1);
    }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .form-submit {
        width: 100%;
        margin-top: 8px;
    }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        cursor: pointer;
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.4;
    }

    .checkbox-label a {
        color: var(--primary);
        text-decoration: underline;
    }

    .checkbox-label input[type="checkbox"],
    .checkbox-label input[type="radio"] {
        width: 16px;
        height: 16px;
        margin-top: 2px;
        accent-color: var(--primary);
        cursor: pointer;
    }

    .form-fieldset {
        border: 0;
        padding: 0;
        min-width: 0;
    }

    .form-fieldset legend {
        padding: 0;
    }

    .radio-list {
        display: grid;
        gap: 10px;
    }

    .radio-list .checkbox-label {
        font-size: 0.92rem;
        color: var(--text);
    }

    .form-help {
        display: block;
        margin-top: 6px;
        font-size: 0.84rem;
        color: var(--muted);
    }

    .form-privacy {
        margin-top: 14px;
        font-size: 0.84rem;
        text-align: center;
    }

    .form-privacy a {
        color: var(--primary);
        text-decoration: underline;
    }

    .contact-info {
        display: grid;
        gap: 16px;
    }

    .contact-info-card {
        padding: 22px 24px;
        background: var(--surface);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
    }

    .contact-info-card h3 {
        font-size: 0.88rem;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .contact-info-card a {
        font-weight: 700;
        font-size: 1.02rem;
        transition: color 180ms ease;
    }

    .contact-info-card a:hover {
        color: var(--primary);
    }

    .contact-info-card span {
        font-weight: 700;
        font-size: 1.02rem;
    }

    .contact-info-note {
        display: block;
        margin-top: 4px;
        font-weight: 500;
        font-size: 0.86rem;
        color: var(--muted);
    }

    @media (max-width: 980px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .contact-info {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .contact-info {
            grid-template-columns: 1fr;
        }
    }

    [data-fs-error] {
        color: #dc3455;
        font-size: 0.82rem;
    }

    input[aria-invalid='true'],
    select[aria-invalid='true'],
    textarea[aria-invalid='true'] {
        border-color: #dc3455;
    }

    [data-fs-success][data-fs-active] {
        background: #d4edda;
        color: #155724;
        padding: 24px 20px;
        border-radius: var(--radius-md);
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        line-height: 1;

        strong {
            font-size: 1.4rem;
            margin-bottom: 12px;
        }
    }

    [data-fs-error=""][data-fs-active] {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 16px;
        border-radius: var(--radius-sm);
        font-size: 0.92rem;
        margin-bottom: 16px;
    }
</style>

<script>
    import { initForm } from "@formspree/ajax";

    const params = new URLSearchParams(window.location.search);
    const preselect = params.get('interest');
    if (preselect) {
        const radio = document.querySelector<HTMLInputElement>(`input[name="interest"][data-slug="${CSS.escape(preselect)}"]`);
        if (radio) radio.checked = true;
    }

    document.querySelector('#contact-form')?.addEventListener('submit', () => {
        const name = document.querySelector<HTMLInputElement>('#name')?.value.trim() ?? '';
        const target = document.querySelector('#success-name');
        if (target) target.textContent = name;
    });

    initForm({
        formElement: '#contact-form',
        formId: 'xdarkjga',
        onSuccess: () => {
            const form = document.querySelector('#contact-form') as HTMLFormElement;
            if (form) {
                form.style.display = 'none';
            }
        }
    });
</script>
