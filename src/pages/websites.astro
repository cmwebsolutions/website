---
import GradientText from '../components/GradientText.astro';
import HeroGrid from '../components/HeroGrid.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import Steps from '../components/Steps.astro';
import MessagesSquare from '@lucide/astro/icons/messages-square';
import FileText from '@lucide/astro/icons/file-text';
import PenTool from '@lucide/astro/icons/pen-tool';
import Rocket from '@lucide/astro/icons/rocket';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import WebsiteTypesCarousel from '../components/WebsiteTypesCarousel.astro';
import Photo from '../components/Photo.astro';
import CircleCheckBig from '@lucide/astro/icons/circle-check-big';
import CircleMinus from '@lucide/astro/icons/circle-minus';
import { gbp, carePlan, staticPlan, websiteBuilds, managedPlan } from '../data/plans';
import { photos } from '../data/images';

const businessFrom = gbp(websiteBuilds.businessFrom);

const steps = [
    { heading: 'We talk.', icon: MessagesSquare, description: 'A free 30-minute call about your business, what the website needs to do, your timeline and budget.' },
    { heading: 'We send a proposal.', icon: FileText, description: "Within 3 working days: the scope, what's not included, a timeline and a fixed price." },
    { heading: 'Design.', icon: PenTool, description: 'We design your site, with 2 rounds of revisions.' },
    { heading: 'Build and launch.', icon: Rocket, description: "We build, test and launch your site, and move everything across if you're replacing an old one." },
    { heading: 'We look after it.', icon: ShieldCheck, description: 'Every website comes with a Care plan, so it stays secure, updated and backed up.' },
];

const faqs = [
    {
        question: 'How long does a website take?',
        answer: 'Most Business websites take 2–4 weeks from agreed designs to launch, depending on content. Larger and integrated sites are scheduled in the proposal.',
    },
    {
        question: 'WordPress or static?',
        answer: "WordPress if you want lots of plugins or a familiar editor; static if you want the fastest, most secure site with the least maintenance. We'll recommend what suits you.",
    },
    {
        question: 'Do I own the website?',
        answer: 'Yes. Once the project is paid in full, the design, code and content are yours.',
    },
    {
        question: 'Do I have to take a Care plan?',
        answer: "It's included in every proposal because websites need looking after. If you'd rather maintain it yourself, just say so.",
    },
];
---

<Layout
    title="Website Design & Development for UK Businesses | Ellveren"
    description={`Fixed-price websites for established UK businesses, from ${businessFrom}. Business websites, integrated websites connected to your other systems, and client portals.`}
    openGraph={{
        basic: {
            title: "Website Design & Development for UK Businesses | Ellveren",
            type: "website",
            image: "/og-image.png",
        },
        optional: {
            siteName: "Ellveren",
            locale: "en_GB",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@ellveren",
    }}
>
    <Header />
    <main>
        <section class="section websites-hero">
            <div class="websites-bg"><HeroGrid /></div>
            <div class="container">
                <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Websites' }]} />
                <div class="websites-hero-content">
                    <h1>Websites built properly, and <GradientText>looked after properly</GradientText></h1>
                    <p class="lead">Fixed-price websites designed and built for your business, connected to the tools you already use where you need them, and looked after on a clear monthly plan once they're live.</p>
                    <div class="hero-actions">
                        <a href="/contact?interest=new-website" class="btn btn-accent">Talk about your project</a>
                        <a href="/plans" class="btn btn-ghost">See the plans</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="section" id="choose">
            <div class="container">
                <div class="section-head">
                    <h2>Choose your website</h2>
                </div>

                <WebsiteTypesCarousel />
            </div>
        </section>

        <section class="section section-soft" id="how-it-works">
            <div class="container">
                <div class="section-head">
                    <h2>How it works</h2>
                </div>
                <div class="process-photo">
                    <Photo photo={photos.websitesProcess} aspect="21 / 9" sizes="(max-width: 1200px) 100vw, 1160px" />
                </div>
                <Steps steps={steps} />
            </div>
        </section>

        <section class="section" id="prices">
            <div class="container">
                <div class="types-grid types-grid--two">
                    <div class="card">
                        <h3>Prices and payment</h3>
                        <ul class="check-list">
                            <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Fixed prices,</strong> agreed before work starts. No surprise bills.</span></li>
                            <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>50% to book, 50% at launch.</strong> Projects over {gbp(websiteBuilds.stagedPaymentsOver)} are paid in three stages (40% / 40% / 20%).</span></li>
                            <li><span class="check"><CircleCheckBig size={20} /></span><span><strong>Care plan from {gbp(carePlan.price)}/month</strong> once your site is live (or the Static plan at {gbp(staticPlan.price)}/month for static sites). See <a href="/plans">Plans</a>.</span></li>
                            <li><span class="check"><CircleCheckBig size={20} /></span><span>You supply your text and images, or we can quote for copywriting.</span></li>
                            <li><span class="check"><CircleCheckBig size={20} /></span><span>No VAT is added: Ellveren isn't VAT registered.</span></li>
                        </ul>
                        <p class="card-note">Smaller business? The <a href="/managed-website-plan">Managed Website Plan</a> gets you a new 5-page website for {gbp(managedPlan.setup)} setup and {gbp(managedPlan.monthly)}/month.</p>
                    </div>

                    <div class="card">
                        <h3>What to expect</h3>
                        <ul class="check-list">
                            <li><span class="check"><CircleMinus size={20} /></span><span>Online shops on WooCommerce are something we build, but they're scoped and quoted separately from our standard websites, not part of the fixed-price range.</span></li>
                            <li><span class="check"><CircleMinus size={20} /></span><span>Very low-budget sites. We don't compete with DIY site builders. If you want to manage everything yourself on a template, Squarespace or Wix may suit you better.</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <FAQ heading="FAQs" description="" questions={faqs} />

        <section class="section">
            <div class="container">
                <div class="cta-banner">
                    <h2>Ready to talk about your website?</h2>
                    <a href="/contact?interest=new-website" class="btn btn-accent cta-banner-btn">Book a free 30-minute call</a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    .websites-hero {
        position: relative;
        padding: 144px 0 100px;
        color: var(--white);
        overflow: hidden;
    }

    .websites-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(126, 168, 240, 0.3) 0%, transparent 100%),
                    radial-gradient(ellipse 60% 50% at 80% 80%, rgba(245, 111, 81, 0.12) 0%, transparent 100%),
                    var(--black);
        z-index: 0;
    }

    .websites-hero-content {
        position: relative;
        z-index: 1;
        max-width: 700px;
        margin-inline: auto;
        text-align: center;
    }

    .websites-hero-content h1 {
        color: var(--white);
        margin-inline: auto;
    }

    .websites-hero-content :global(.lead) {
        color: var(--dark-muted);
        margin-inline: auto;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 32px;
    }

    .types-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 28px;
        align-items: start;
    }

    .types-grid--two {
        grid-template-columns: repeat(2, 1fr);
        margin-top: 0;
    }

    .types-grid .card > p {
        margin-top: 14px;
    }

    .check-list strong {
        color: var(--black);
    }

    .check-list a,
    .card-note a {
        color: var(--primary);
        text-decoration: underline;
    }

    .types-grid .card-note {
        margin-top: 20px;
    }

    .process-photo {
        margin-bottom: 28px;
    }

    .cta-banner {
        text-align: center;
        max-width: 600px;
        margin-inline: auto;
    }

    .cta-banner h2 {
        margin-inline: auto;
    }

    .cta-banner-btn {
        margin-top: 32px;
    }

    @media (max-width: 980px) {
        .types-grid,
        .types-grid--two {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .process-photo {
            --photo-aspect: 16 / 9;
        }
    }
</style>
