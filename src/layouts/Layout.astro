---
import '../styles/global.css';
import '@fontsource-variable/geist/wght.css';
import { SEO } from 'astro-seo';
import type { SEOProps } from 'astro-seo';

interface Props extends Omit<SEOProps, 'title' | 'description'> {
    title: string;
    description?: string;
}

const { title, description, openGraph, twitter, canonical, ...seoProps } = Astro.props;
const resolvedDescription = description ?? "Websites, bespoke software, ongoing technical support and digital growth. Ellveren is a technology partner for growing businesses.";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(openGraph?.basic.image ?? '/og-image.png', Astro.site).href;
const resolvedOpenGraph = {
    ...openGraph,
    basic: {
        title,
        type: 'website',
        ...openGraph?.basic,
        url: canonicalUrl,
        image: socialImage,
    },
    optional: {
        siteName: 'Ellveren',
        locale: 'en_GB',
        ...openGraph?.optional,
        description: resolvedDescription,
    },
    image: {
        ...openGraph?.image,
        alt: 'Ellveren — Technology for growing businesses.',
    },
};
---

<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO
        title={title}
        description={resolvedDescription}
        {...seoProps}
        canonical={canonicalUrl}
        openGraph={resolvedOpenGraph}
        twitter={{
            ...twitter,
            title,
            description: resolvedDescription,
            image: socialImage,
            imageAlt: 'Ellveren — Technology for growing businesses.',
        }}
    />

    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <script
        is:inline
        defer
        data-domain="ellveren.com"
        src="https://plausible.io/js/script.js"
    ></script>
    <script is:inline type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "Ellveren",
            "legalName": "Ellveren Ltd",
            "description": "Websites, bespoke software, technical support and digital growth for growing businesses.",
            "email": "hello@ellveren.com",
            "url": "https://ellveren.com",
            "logo": "https://ellveren.com/Logo.svg",
            "contactPoint": {
                "@type": "ContactPoint",
                "telephone": "+443302296586",
                "contactType": "customer service"
            },
            "sameAs": [
                "https://www.linkedin.com/company/ellveren/"
            ]
        }
    </script>
</head>

<body>
    <slot />
</body>
</html>
