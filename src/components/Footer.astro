---
import HeroGrid from './HeroGrid.astro';
---

<footer class="site-footer">
    <div class="site-footer-bg"><HeroGrid /></div>
    <div class="container site-footer-content">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="footer-logo-link" aria-label="Ellveren home">
                    <img class="footer-logo" src="/LogoWhite.svg" alt="Ellveren" width="180" height="30" />
                </a>
                <p class="footer-desc">
                    Technology for growing businesses. Websites, bespoke software, technical support and digital growth.
                </p>
                <div class="footer-contact">
                    <a href="mailto:hello@ellveren.com">hello@ellveren.com</a>
                    <span class="footer-contact-item">0330 229 6586</span>
                    <a target="_blank" href="https://www.linkedin.com/company/ellveren/" class="footer-contact-item">LinkedIn</a>
                </div>
            </div>

            <nav class="footer-nav" aria-label="Footer navigation">
                <span class="footer-nav-heading">Quick links</span>
                <a href="/services">Services</a>
                <a href="/websites">Websites</a>
                <a href="/plans">Plans</a>
                <a href="/work">Our Work</a>
                <a href="/about">About</a>
                <a href="/blog">Blog</a>
                <a href="/contact">Contact</a>
            </nav>
        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-row">
                <p>&copy; 2026 Ellveren Ltd. All rights reserved. Ellveren Ltd, formerly Custom Made Web Solutions Ltd.</p>
                <nav class="footer-policies" aria-label="Legal">
                    <a href="/privacy">Privacy policy</a>
                    <a href="/terms">Terms of service</a>
                </nav>
            </div>
            <p class="footer-legal">
                Registered Office: Friarswood, Chipperfield Road, Kings Langley, Hertfordshire, England, WD4 9JB <br>
                Registered in England and Wales, No. 15582477
            </p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        padding: 60px 0 0;
        color: rgba(250, 242, 237, 0.58);
        background: var(--black);
    }

    .site-footer-content {
        position: relative;
        z-index: 1;
    }

    /* The dark background sits on this layer too, so the grid's screen blending has
       something to blend with (this layer is its own stacking context). */
    .site-footer-bg {
        position: absolute;
        inset: 0;
        background: var(--black);
        pointer-events: none;
        z-index: 0;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 60px;
    }

    .footer-logo-link {
        display: inline-flex;
    }

    .footer-logo {
        height: 30px;
        width: auto;
        display: block;
    }

    .footer-desc {
        max-width: 400px;
        margin-top: 18px;
        color: rgba(250, 242, 237, 0.52);
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .footer-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 22px;
    }

    .footer-contact a {
        transition: color 180ms ease;
    }

    .footer-contact a:hover {
        color: var(--accent);
    }

    .footer-nav {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-nav-heading {
        color: var(--white);
        font-weight: 800;
        font-size: 0.92rem;
        margin-bottom: 4px;
    }

    .footer-nav a {
        transition: color 180ms ease;
    }

    .footer-nav a:hover {
        color: var(--accent);
    }

    .footer-bottom {
        margin-top: 48px;
        padding: 22px 0;
        border-top: 1px solid rgba(250, 242, 237, 0.08);
        font-size: 0.84rem;
    }

    .footer-bottom p {
        color: rgba(250, 242, 237, 0.38);
    }

    .footer-bottom-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 6px 24px;
    }

    .footer-policies {
        display: flex;
        gap: 18px;
    }

    .footer-policies a {
        color: rgba(250, 242, 237, 0.38);
        transition: color 180ms ease;
    }

    .footer-policies a:hover {
        color: var(--white);
    }

    .footer-legal {
        margin-top: 4px;
    }

    @media (max-width: 980px) {
        .footer-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
    }
</style>
