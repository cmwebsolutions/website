---
import HeroGrid from './HeroGrid.astro';

interface Props {
    transparent?: boolean;
}

const { transparent = true } = Astro.props;

const mobileLinks = [
    { href: '/services', label: 'Services' },
    { href: '/websites', label: 'Websites' },
    { href: '/plans', label: 'Plans' },
    { href: '/work', label: 'Work' },
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
    { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" class:list={{ 'site-header--scrolled': !transparent, 'site-header--solid': !transparent }}>
    <div class="container">
        <nav class="nav" aria-label="Primary navigation">
            <a class="brand" href="/" aria-label="Ellveren home">
                <img class="brand-logo brand-logo--white" src="/LogoWhite.svg" alt="Ellveren" width="160" height="27" />
                <img class="brand-logo brand-logo--dark" src="/Logo.svg" alt="Ellveren" width="160" height="27" />
            </a>

            <div class="nav-links">
                <a href="/services">Services</a>
                <a href="/websites">Websites</a>
                <a href="/plans">Plans</a>
                <a href="/work">Work</a>
                <a href="/about">About</a>
                <a href="/blog">Blog</a>
                <a href="/contact">Contact</a>
            </div>

            <div class="nav-actions">
                <a class="btn btn-primary" href="/contact">Book a call</a>
                <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>

        <div class="nav-mobile" id="nav-mobile">
            <HeroGrid />
            <nav class="nav-mobile-links" aria-label="Mobile navigation">
                {mobileLinks.map((link, i) => (
                    <a
                        href={link.href}
                        style={`--i: ${i}`}
                        aria-current={path === link.href || path.startsWith(`${link.href}/`) ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
        </div>
    </div>
</header>

<script>
    const header = document.querySelector('.site-header');
    if (header) {
        const toggleHeader = () => header.classList.toggle('site-header--scrolled', window.scrollY > 10);
        window.addEventListener('scroll', toggleHeader, { passive: true });
        toggleHeader();
    }

    // Full-screen mobile menu: locks page scroll while open; Escape, a link or the button closes it.
    const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
    if (header && hamburger) {
        const setOpen = (open: boolean) => {
            header.classList.toggle('nav-open', open);
            hamburger.setAttribute('aria-expanded', String(open));
            hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            document.documentElement.style.overflow = open ? 'hidden' : '';
        };

        hamburger.addEventListener('click', () => setOpen(!header.classList.contains('nav-open')));

        document.querySelectorAll('.nav-mobile a').forEach((link) => {
            link.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && header.classList.contains('nav-open')) {
                setOpen(false);
                hamburger.focus();
            }
        });

        // Close it if the window grows past the mobile breakpoint.
        window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => {
            if (event.matches) setOpen(false);
        });
    }
</script>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: transparent;
        transition: background 200ms ease, border-color 200ms ease;
    }

    .site-header--scrolled {
        background: rgba(250, 242, 237, 0.82);
        border-bottom: 1px solid rgba(29, 33, 42, 0.08);
        backdrop-filter: blur(18px);
    }

    .site-header--solid {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
    }

    .site-header--solid .brand-logo--white {
        display: none;
    }

    .site-header--solid .brand-logo--dark {
        display: block;
    }

    .brand-logo {
        display: block;
        height: 27px;
        width: auto;
    }

    .brand-logo--dark {
        display: none;
    }

    .brand-logo--white {
        display: block;
    }

    .site-header--scrolled .brand-logo--white {
        display: none;
    }

    .site-header--scrolled .brand-logo--dark {
        display: block;
    }

    .site-header--solid .nav-links {
        color: var(--muted);
    }

    .site-header--solid .nav-links a:hover {
        color: var(--primary);
    }

    .site-header--solid .hamburger span {
        background: var(--black);
    }

    .nav {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
        color: var(--dark-muted);
        font-size: 0.92rem;
        font-weight: 600;
        transition: color 200ms ease;
    }

    .site-header--scrolled .nav-links {
        color: var(--muted);
    }

    .nav-links a {
        transition: color 180ms ease;
    }

    .nav-links a:hover {
        color: var(--accent);
    }

    .site-header--scrolled .nav-links a:hover {
        color: var(--primary);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        background: none;
        cursor: pointer;
        transition: transform 180ms ease;
    }

    .hamburger span {
        display: block;
        width: 100%;
        height: 2.5px;
        border-radius: 2px;
        background: var(--white);
        transition: transform 200ms ease, opacity 200ms ease;
    }

    .site-header--scrolled .hamburger span {
        background: var(--black);
    }

    .nav-open .hamburger span:nth-child(1) {
        transform: translateY(7.5px) rotate(45deg);
    }

    .nav-open .hamburger span:nth-child(2) {
        opacity: 0;
    }

    .nav-open .hamburger span:nth-child(3) {
        transform: translateY(-7.5px) rotate(-45deg);
    }

    /* Full-screen mobile menu. It sits behind the header bar (negative z-index inside the
       header's stacking context), so the logo and close button stay on top. */
    .nav-mobile {
        position: fixed;
        inset: 0;
        z-index: -1;
        display: none;
        place-items: center;
        padding: 96px 24px 48px;
        overflow-y: auto;
        background: var(--black);
        opacity: 0;
        visibility: hidden;
        transition: opacity 260ms ease, visibility 260ms ease;
    }

    .nav-open .nav-mobile {
        opacity: 1;
        visibility: visible;
    }

    .nav-mobile-links {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
    }

    .nav-mobile-links a {
        padding: 6px 12px;
        color: var(--white);
        font-family: var(--font-heading);
        font-size: clamp(1.9rem, 8vw, 2.6rem);
        font-weight: 800;
        line-height: 1.15;
        opacity: 0;
        transform: translateY(12px);
        transition:
            color 180ms ease,
            opacity 300ms ease,
            transform 300ms ease;
    }

    /* Links fade up one after another as the menu opens. */
    .nav-open .nav-mobile-links a {
        opacity: 1;
        transform: none;
        transition-delay: calc(80ms + var(--i) * 40ms), calc(80ms + var(--i) * 40ms), calc(80ms + var(--i) * 40ms);
    }

    .nav-mobile-links a:hover,
    .nav-mobile-links a[aria-current='page'] {
        color: var(--accent);
    }

    /* While open the header bar is see-through, with the white logo and close icon.
       Dropping the backdrop filter also lets the fixed menu fill the whole screen. */
    .site-header.nav-open {
        background: transparent;
        border-bottom-color: transparent;
        backdrop-filter: none;
    }

    .site-header.nav-open .brand-logo--white {
        display: block;
    }

    .site-header.nav-open .brand-logo--dark {
        display: none;
    }

    .site-header.nav-open .hamburger span {
        background: var(--white);
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-mobile,
        .nav-mobile-links a {
            transition: none;
            transform: none;
        }
    }

    @media (max-width: 980px) {
        .nav-links {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .nav-mobile {
            display: grid;
        }
    }

    @media (max-width: 640px) {
        .nav {
            min-height: 64px;
            padding: 12px 0;
        }

        .brand-logo {
            height: 22px;
        }
    }
</style>
