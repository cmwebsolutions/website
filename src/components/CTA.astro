---
interface Props {
    eyebrow?: string;
    heading?: string;
    description?: string;
    interest?: string;
}

// Call-to-action panel. All enquiries go through the single form on /contact;
// `interest` pre-selects an option there (a slug from src/data/enquiry.ts).
const {
    eyebrow = "Free consultation",
    heading = "What would help your business move forward?",
    description = "Tell us about your project and we'll put together a custom proposal. No obligation, just a friendly chat.",
    interest,
} = Astro.props;

const href = interest ? `/contact?interest=${encodeURIComponent(interest)}` : '/contact';
---

<section class="cta" id="consultation">
    <div class="container">
        <div class="cta-panel">
            <div class="cta-text">
                <span class="eyebrow">{eyebrow}</span>
                <h2>{heading}</h2>
                <p class="lead">{description}</p>
            </div>
            <a href={href} class="btn btn-dark cta-btn">Book my free consultation</a>
        </div>
    </div>
</section>

<style>
    .cta {
        padding: 92px 0;
        background: var(--surface-soft);
    }

    .cta-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px 48px;
        padding: clamp(32px, 5vw, 58px);
        background:
            linear-gradient(135deg, #7EA8F0, #F56F51);
        border-radius: var(--radius-xl);
    }

    .cta-text {
        max-width: 640px;
    }

    /* Extra specificity so blog-post link styles don't recolour the button. */
    .cta-panel .cta-btn {
        flex: 0 0 auto;
        color: var(--white);
        text-decoration: none;
    }

    @media (max-width: 860px) {
        .cta-panel {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
