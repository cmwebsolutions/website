---
import { gbp, carePlan, websiteBuilds } from '../data/plans';
---

<section class="section routes">
    <div class="container">
        <div class="routes-grid">
            <article class="card">
                <h3>Already have a website?</h3>
                <p>Keep it secure, updated and backed up with a Care plan, from {gbp(carePlan.price)}/month. Start with a free health check.</p>
                <a href="/plans" class="route-link">Care plans</a>
            </article>
            <article class="card">
                <h3>Need a new website?</h3>
                <p>Fixed-price websites, designed and built for your business, from {gbp(websiteBuilds.businessFrom)}.</p>
                <a href="/websites" class="route-link">Websites</a>
            </article>
            <article class="card">
                <h3>Need more than a website?</h3>
                <p>Sites connected to your other systems, client portals and web apps.</p>
                <a href="/websites#integrated" class="route-link">Integrated websites</a>
            </article>
        </div>
    </div>
</section>

<style>
    .routes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .routes-grid .card {
        display: flex;
        flex-direction: column;
    }

    .routes-grid .card p {
        flex: 1;
    }

    .route-link {
        margin-top: 20px;
        color: var(--primary);
        font-weight: 800;
        text-decoration: underline;
    }

    @media (max-width: 980px) {
        .routes-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
